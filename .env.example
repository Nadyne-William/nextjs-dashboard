# Copy from .env.local on the Vercel dashboard
# https://nextjs.org/learn/dashboard-app/setting-up-your-database#create-a-postgres-database
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000/api/auth
# Minutes of inactivity before the idle timer signs people out (default 15).
# Set to 0.5 to watch the warning and sign-out happen in 30 seconds.
IDLE_TIMEOUT_MINUTES=15

# Required to run /seed in production: visit /seed?secret=<this value>.
SEED_SECRET=
